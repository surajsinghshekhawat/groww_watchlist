# Application
APP_NAME=Smart Market Watchlist
APP_ENV=development
DEBUG=true

# Database (Postgres)
POSTGRES_USER=watchlist
POSTGRES_PASSWORD=watchlist
POSTGRES_DB=watchlist
DATABASE_URL=postgresql+asyncpg://watchlist:watchlist@127.0.0.1:55432/watchlist

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth ? replace JWT_SECRET before any real deployment
JWT_SECRET=dev-only-change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (comma-separated). Never use * with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Market data mode: replay (judge demo) | yahoo (delayed NSE via yfinance) | live | mock
MARKET_DATA_MODE=replay

# Demo talk-track
DEMO_CONFLICT_SYMBOL=TCS
DEMO_SKIP_CALIBRATION=false
MAX_PRICE_ANOMALY_Z=8.0

# Groww Trade API is paid (no free tier) ? leave unused unless subscribed
# GROWW_API_KEY=
# GROWW_API_SECRET=

# LLM ? see docs/LLM.md (Groq recommended free tier)
ENABLE_LLM=false
ENABLE_WEB_RETRIEVAL=true
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Feature flags
ENABLE_CUSUM=true
ENABLE_NEWS=false
ENABLE_ROLLING_OLS=false
ENABLE_ISOLATION_FOREST=false
ENABLE_FINBERT=false

# Scoring defaults
TOP_K=5
HISTORY_SESSIONS=20
MIN_HISTORY_POINTS=30
FRESHNESS_LIMIT_SECONDS=30
SOURCE_CONFLICT_TOLERANCE=0.01
MAX_WATCHLIST_SIZE=100
RVOL_THRESHOLD=2.0
CONTEXT_THRESHOLD=0.015

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Web Push (VAPID) ? generate with: python -c \"...\" or npx web-push generate-vapid-keys
ENABLE_WEB_PUSH=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:demo@example.com
